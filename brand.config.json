{
    "brand_name": "Donne Hunter",
    "brand_domain": "donnehunter.com",
    "brand_hostname": {
        "staging": "staging.donnehunter.com/dashboard",
        "production": "donnehunter.com/dashboard"
    },
    "domain_name": "DonneHunter.com",
    "colors": {
        "primary": "#00d4ff",
        "secondary": "#7b2ff7",
        "tertiary": "#ff0080",
        "success": "#00ff88",
        "danger": "#ff4444",
        "warning": "#ffaa00",
        "info": "#00d4ff",
        "neutral": "#6b7280",
        "black": "#0a0a1a",
        "white": "#ffffff",
        "grey": {
            "50": "#f8fafc",
            "100": "#f1f5f9",
            "200": "#e2e8f0",
            "300": "#cbd5e1",
            "400": "#94a3b8",
            "500": "#64748b",
            "600": "#475569",
            "700": "#334155",
            "800": "#1e293b",
            "900": "#0f172a"
        }
    },
    "typography": {
        "font_family": {
            "primary": "Orbitron, Inter, sans-serif",
            "secondary": "Rajdhani, Inter, sans-serif",
            "monospace": "'Courier New', Courier, monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [100, 200, 300, 400, 500],
        "dark_variants": [600, 700, 800, 900],
        "opacity_variants": [10, 20, 30, 40, 50, 60, 70, 80, 90]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "DONNEHUNTER TRADING HUB",
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": true
        },
        "hostname": {
            "production": {
                "com": "bot.donnehunter.com"
            },
            "staging": {
                "com": "staging-bot.donnehunter.com"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        },
        "show_name": true,
        "logo_path": "/logo.png"
    }
}
